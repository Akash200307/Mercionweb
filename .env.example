# Server (never expose KEY_SECRET to the browser)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# Vite frontend — KEY_ID only
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Leave empty in local/dev to use Vite proxy (/api → :3001)
VITE_API_URL=

# WHMCS client portal (no trailing slash)
VITE_WHMCS_URL=https://billing.mercion.in

VITE_WHMCS_PID_STARTER=1
VITE_WHMCS_PID_PRO=2
VITE_WHMCS_PID_BUSINESS=3
VITE_WHMCS_PID_WP_STARTER=4
VITE_WHMCS_PID_WP_PRO=5
VITE_WHMCS_PID_WP_BUSINESS=6

# Optional support phone / WhatsApp
# VITE_SUPPORT_PHONE=+91 98XXXXXXXX
