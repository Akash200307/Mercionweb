# ---------------------------------------------------------------------------
# Production environment for the Docker Compose deployment.
# Copy to `.env` (git-ignored) and replace every placeholder with real values:
#     cp .env.production.example .env
# ---------------------------------------------------------------------------

# --- Server / API (secrets — never expose to the browser) ------------------
# Use LIVE Razorpay keys in production (rzp_live_...). Test keys are fine for staging.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_real_secret

# Long random string used to sign auth tokens. Generate e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_with_a_long_random_string

# Port the API listens on INSIDE the container (not published to the host).
PORT=3001

# --- Frontend (VITE_*) — public, baked into the SPA at build time ----------
# Leave VITE_API_URL empty so the browser calls same-origin /api (nginx proxies it).
VITE_API_URL=
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# WHMCS client portal (no trailing slash) and product IDs.
VITE_WHMCS_URL=https://billing.mercion.in
VITE_WHMCS_PID_STARTER=1
VITE_WHMCS_PID_PRO=2
VITE_WHMCS_PID_BUSINESS=3
VITE_WHMCS_PID_WP_STARTER=4
VITE_WHMCS_PID_WP_PRO=5
VITE_WHMCS_PID_WP_BUSINESS=6

# Optional support phone / WhatsApp shown in the UI.
# VITE_SUPPORT_PHONE=+91 98XXXXXXXX

# --- Deployment ------------------------------------------------------------
# Host port that serves the site (maps to nginx :80 in the web container).
WEB_PORT=8080
